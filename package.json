{
  "name": "@fernfly/intent-bar",
  "version": "0.0.0",
  "private": true,
  "description": "An intent bar for web apps: a sentence becomes editable chips with a live preview, and your app runs the result.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernfly/intent-bar.git"
  },
  "homepage": "https://github.com/fernfly/intent-bar#readme",
  "bugs": {
    "url": "https://github.com/fernfly/intent-bar/issues"
  },
  "keywords": [
    "intent bar",
    "command palette",
    "cmdk",
    "natural language",
    "react",
    "shadow dom"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/intent-bar.global.js"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./intent-bar.global.js": "./dist/intent-bar.global.js",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/intent-bar.global.js",
  "jsdelivr": "./dist/intent-bar.global.js",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.11.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.20.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "node examples/harness/serve.mjs",
    "smoke": "node examples/harness/smoke.mjs",
    "size": "node scripts/bundle-report.mjs",
    "bump": "node scripts/bump.mjs",
    "preversion": "node scripts/bump.mjs && npm run typecheck && npm test",
    "postversion": "node scripts/bump.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "cmdk": "^1.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.6",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
